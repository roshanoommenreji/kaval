#!/bin/bash
# First-boot setup for a Kaval node (prod or staging, by name_prefix). Runs once, as root, via cloud-init.
# Log: /var/log/cloud-init-output.log
set -euxo pipefail

# ── k3s, checksum-verified (not the official `curl | sh` installer — same reasoning as
#    the k3d/kubectl/helm downloads in infra/modules/devbox/user_data.sh.tftpl: trust a
#    pinned hash, not an unauthenticated script) ───────────────────────────────────────
K3S_VERSION="${k3s_version}"
K3S_SHA256="${k3s_sha256_arm64}"
curl -fsSLo /tmp/k3s "https://github.com/k3s-io/k3s/releases/download/$${K3S_VERSION/+/%2B}/k3s-arm64"
echo "$${K3S_SHA256}  /tmp/k3s" | sha256sum --check --strict
install -m 0755 /tmp/k3s /usr/local/bin/k3s
rm /tmp/k3s

modprobe br_netfilter || true
modprobe overlay || true

# psql client, for the bootstrap script's db-roles.sql step below (KAV-56). Installed once
# here at first boot, not inside the repeating bootstrap script -- it only needs to exist,
# not be reinstalled every 6h.
dnf install -y postgresql15

# Systemd unit hand-written from k3s's own install.sh template (SYSTEMD_TYPE=notify for a
# server), so the checksum-verified binary above gets the same supervision the official
# installer would have given it, without running that installer's own unverified script.
cat > /etc/systemd/system/k3s.service <<'UNIT'
[Unit]
Description=Kaval k3s server
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
KillMode=process
Delegate=yes
User=root
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s server --write-kubeconfig-mode=644 --disable=traefik

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now k3s

# ── kubectl + helm, same checksum-verified versions already pinned on the dev server ──
KUBECTL_VERSION=v1.37.1
KUBECTL_SHA256=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
curl -fsSLo /tmp/kubectl "https://dl.k8s.io/release/$${KUBECTL_VERSION}/bin/linux/arm64/kubectl"
echo "$${KUBECTL_SHA256}  /tmp/kubectl" | sha256sum --check --strict
install -m 0755 /tmp/kubectl /usr/local/bin/kubectl
rm /tmp/kubectl

HELM_VERSION=v4.3.0
HELM_SHA256=31c5794dd55c66a51e6b7d2e2ac7a114ae8b1de41ff1d9ba51748ac973b06a08
curl -fsSLo /tmp/helm.tgz "https://get.helm.sh/helm-$${HELM_VERSION}-linux-arm64.tar.gz"
echo "$${HELM_SHA256}  /tmp/helm.tgz" | sha256sum --check --strict
tar -xzf /tmp/helm.tgz -C /tmp linux-arm64/helm
install -m 0755 /tmp/linux-arm64/helm /usr/local/bin/helm
rm -rf /tmp/helm.tgz /tmp/linux-arm64

# kubectl/helm need a kubeconfig; k3s writes one root-only by default even with
# write-kubeconfig-mode=644 applied to its *contents* permissions, not its location.
install -d -m 755 /home/ec2-user/.kube
# Written after k3s has actually started and produced the file, not at the ExecStart
# line above -- ready-to-poll, not fixed-delay, since first boot is doing a lot else too.
for i in $(seq 1 60); do
  [ -s /etc/rancher/k3s/k3s.yaml ] && break
  sleep 2
done
cp /etc/rancher/k3s/k3s.yaml /home/ec2-user/.kube/config
chown -R ec2-user:ec2-user /home/ec2-user/.kube
chmod 600 /home/ec2-user/.kube/config

# A root shell reached via `sudo -i` or `aws ssm send-command` has no ~/.kube/config and
# (found live, KAV-50) no $HOME at all under plain SSM RunShellScript, so ~-expansion
# can't find one anyway. k3s's own file is already 644 (write-kubeconfig-mode above), so
# pointing KUBECONFIG at it directly sidesteps both problems without a second copy to
# keep in sync. /etc/environment covers login shells (SSH, `sudo -i`); a non-login
# `ssm send-command` still needs --kubeconfig spelled out explicitly, which is the
# ad-hoc-verification path, not the documented one (SSH through the SSM tunnel).
echo "KUBECONFIG=/etc/rancher/k3s/k3s.yaml" >> /etc/environment

# ── SSH, reachable only through the SSM tunnel (no inbound port is open) — same pattern
#    as infra/modules/devbox ──────────────────────────────────────────────────────────
install -d -m 700 -o ec2-user -g ec2-user /home/ec2-user/.ssh
echo "${ssh_public_key}" >> /home/ec2-user/.ssh/authorized_keys
chown ec2-user:ec2-user /home/ec2-user/.ssh/authorized_keys
chmod 600 /home/ec2-user/.ssh/authorized_keys

cat > /etc/ssh/sshd_config.d/10-kaval-keepalive.conf <<'CONF'
ClientAliveInterval 30
ClientAliveCountMax 3
CONF
systemctl reload sshd

# ── Flux, checksum-verified (KAV-51) — same reasoning as k3s/kubectl/helm above. `flux
# install` only (not `flux bootstrap`, which commits a flux-system manifest straight to
# `main` and would bypass the PR-required branch protection, CLAUDE.md) — it applies the
# controllers' own manifests, embedded in the binary, with no extra network fetch. ──────
FLUX_VERSION="${flux_version}"
FLUX_SHA256="${flux_sha256_arm64}"
curl -fsSLo /tmp/flux.tar.gz \
  "https://github.com/fluxcd/flux2/releases/download/v$${FLUX_VERSION}/flux_$${FLUX_VERSION}_linux_arm64.tar.gz"
echo "$${FLUX_SHA256}  /tmp/flux.tar.gz" | sha256sum --check --strict
tar -xzf /tmp/flux.tar.gz -C /tmp flux
install -m 0755 /tmp/flux /usr/local/bin/flux
rm -f /tmp/flux.tar.gz /tmp/flux

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
flux install

# This node has no EKS-style credential provider for ECR (ADR-0024's IAM-scoping decision:
# per-workload AWS identity is Phase 7/8 IRSA territory, not this story). So two things get
# refreshed from the node's own instance role instead of committed to Git: the registry
# hostname itself (it embeds the AWS account ID — CLAUDE.md forbids that in any committed
# file) and an ECR login token (ecr:GetAuthorizationToken tokens expire every 12h). Both
# are consumed by deploy/gitops/<env>/helmrelease.yaml's valuesFrom (the ConfigMap) and the
# chart's imagePullSecrets (the Secret) — see deploy/charts/kaval/values.yaml.
cat > /usr/local/sbin/kaval-gitops-bootstrap <<'SCRIPT'
#!/bin/bash
set -euo pipefail
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# `set -x` stays OFF for this whole script, deliberately — it would otherwise trace the
# ECR token (a real, live credential, not a name or an ID) into /var/log/cloud-init-
# output.log in plaintext. Found live, re-running this script by hand during KAV-51:
# the trace put the token straight into the SSH session's own output. Fixed by never
# tracing here, and by building the Secret's YAML ourselves (piped via stdin) instead of
# passing the password as a `kubectl` argument, where it would sit in `ps aux` for any
# other process on the node to read for as long as the command runs.

TOKEN=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
REGION=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
ACCOUNT=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/dynamic/instance-identity/document \
  | sed -n 's/.*"accountId" *: *"\([0-9]\+\)".*/\1/p')
REGISTRY="$ACCOUNT.dkr.ecr.$REGION.amazonaws.com"

# The repo's own bootstrap manifests. Flux's own GitRepository (applied below, once) takes
# over all reconciliation of these same files from here on — this apply only has to run
# again if the node itself is replaced (spot reclamation), which is the self-healing
# property the Phase 4 exit gate tests.
RAW="https://raw.githubusercontent.com/roshanoommenreji/kaval/main/deploy/gitops/${gitops_env}"
curl -fsSL "$RAW/namespace.yaml" | kubectl apply -f -

kubectl create configmap kaval-registry --from-literal=registry="$REGISTRY" \
  -n flux-system --dry-run=client -o yaml | kubectl apply -f -

# Built and applied entirely via stdin, never a kubectl argument — `kubectl create secret
# ... --docker-password=` would otherwise sit in this process's own argv (readable via
# `ps aux` by anything else on the node) for as long as the command runs.
ECR_PASSWORD=$(aws ecr get-login-password --region "$REGION")
AUTH_B64=$(printf '%s' "AWS:$ECR_PASSWORD" | base64 -w0)
DOCKERCONFIGJSON_B64=$(printf '{"auths":{"%s":{"username":"AWS","password":"%s","auth":"%s"}}}' \
  "$REGISTRY" "$ECR_PASSWORD" "$AUTH_B64" | base64 -w0)
cat <<MANIFEST | kubectl apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: ecr-cred
  namespace: ${name_prefix}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: $DOCKERCONFIGJSON_B64
MANIFEST
unset ECR_PASSWORD AUTH_B64 DOCKERCONFIGJSON_B64

# Database + Slack secrets (KAV-56): same refresh pattern as ecr-cred above -- read from
# SSM, build the Secret entirely via stdin (never a kubectl argument, so nothing sits in
# `ps aux`), apply it. Runs on every boot and on this same script's 6h timer, so a node
# replacement (spot reclamation) never again needs a human to type kubectl create secret.
declare -A DB_ROLE_USERS=( [admin]=kaval [gateway]=kaval_gateway [agent]=kaval_agent [executor]=kaval_executor [collector]=kaval_collector )
DB_HOST=$(aws ec2 describe-instances --region "$REGION" \
  --filters "Name=tag:Role,Values=database" "Name=tag:Name,Values=${name_prefix}-database" "Name=instance-state-name,Values=running" \
  --query "Reservations[0].Instances[0].PrivateIpAddress" --output text)

for role in "$${!DB_ROLE_USERS[@]}"; do
  DB_PASSWORD=$(aws ssm get-parameter --region "$REGION" \
    --name "/kaval/${name_prefix}/db/$${role}-password" --with-decryption \
    --query Parameter.Value --output text)
  kubectl create secret generic "kaval-postgres-$${role}" -n ${name_prefix} \
    --from-literal=POSTGRES_HOST="$DB_HOST" \
    --from-literal=POSTGRES_PORT=5432 \
    --from-literal=POSTGRES_DB=kaval \
    --from-literal=POSTGRES_USER="$${DB_ROLE_USERS[$role]}" \
    --from-literal=POSTGRES_PASSWORD="$DB_PASSWORD" \
    --from-literal=POSTGRES_SSLMODE=require \
    --dry-run=client -o yaml | kubectl apply -f -
  unset DB_PASSWORD
done

SLACK_BOT_TOKEN=$(aws ssm get-parameter --region "$REGION" --with-decryption \
  --name "/kaval/${name_prefix}/slack/bot-token" --query Parameter.Value --output text)
SLACK_APP_TOKEN=$(aws ssm get-parameter --region "$REGION" --with-decryption \
  --name "/kaval/${name_prefix}/slack/app-token" --query Parameter.Value --output text)
SLACK_CHANNEL_ID=$(aws ssm get-parameter --region "$REGION" \
  --name "/kaval/${name_prefix}/slack/channel-id" --query Parameter.Value --output text)
kubectl create secret generic kaval-slack -n ${name_prefix} \
  --from-literal=SLACK_BOT_TOKEN="$SLACK_BOT_TOKEN" \
  --from-literal=SLACK_APP_TOKEN="$SLACK_APP_TOKEN" \
  --from-literal=SLACK_CHANNEL_ID="$SLACK_CHANNEL_ID" \
  --dry-run=client -o yaml | kubectl apply -f -
unset SLACK_BOT_TOKEN SLACK_APP_TOKEN SLACK_CHANNEL_ID

curl -fsSL "$RAW/source.yaml" | kubectl apply -f -
curl -fsSL "$RAW/helmrelease.yaml" | kubectl apply -f -
# From here, kustomize-controller's own Kustomization (sync.yaml) takes over watching this
# whole directory from Git on its own interval — this script only has to seed it once.
curl -fsSL "$RAW/sync.yaml" | kubectl apply -f -

# Per-service Postgres roles (KAV-56, scripts/ops/db-roles.sql): idempotent, safe to rerun
# every 6h alongside the Secrets above. Its GRANTs need the schema, which migrate-job (a Helm
# hook) creates -- and migrate-job only runs once Flux has been seeded, just above. This block
# used to sit BEFORE that, so on a fresh database it failed every time ("relation signal does
# not exist") and the services stayed locked out until the next 6h timer. Found live, KAV-57:
# a staging cluster is meant to be usable in minutes, not hours. So it now runs last, and waits
# (up to ~10 min, non-fatal) for the schema to exist. On an existing database the schema is
# already there and the wait is instant.
curl -fsSL -o /tmp/db-roles.sql "https://raw.githubusercontent.com/roshanoommenreji/kaval/main/scripts/ops/db-roles.sql"
ADMIN_PW=$(aws ssm get-parameter --region "$REGION" --with-decryption \
  --name "/kaval/${name_prefix}/db/admin-password" --query Parameter.Value --output text)
GATEWAY_PW=$(aws ssm get-parameter --region "$REGION" --with-decryption \
  --name "/kaval/${name_prefix}/db/gateway-password" --query Parameter.Value --output text)
AGENT_PW=$(aws ssm get-parameter --region "$REGION" --with-decryption \
  --name "/kaval/${name_prefix}/db/agent-password" --query Parameter.Value --output text)
EXECUTOR_PW=$(aws ssm get-parameter --region "$REGION" --with-decryption \
  --name "/kaval/${name_prefix}/db/executor-password" --query Parameter.Value --output text)
COLLECTOR_PW=$(aws ssm get-parameter --region "$REGION" --with-decryption \
  --name "/kaval/${name_prefix}/db/collector-password" --query Parameter.Value --output text)
SCHEMA_READY=""
for attempt in $(seq 1 40); do
  if PGPASSWORD="$ADMIN_PW" psql "host=$DB_HOST port=5432 dbname=kaval user=kaval sslmode=require" \
       -tAc "select to_regclass('public.signal')" 2>/dev/null | grep -q signal; then
    SCHEMA_READY=1
    break
  fi
  sleep 15
done
if [ -n "$SCHEMA_READY" ]; then
  PGPASSWORD="$ADMIN_PW" psql "host=$DB_HOST port=5432 dbname=kaval user=kaval sslmode=require" \
    -v ON_ERROR_STOP=1 \
    -v gateway_password="$GATEWAY_PW" \
    -v agent_password="$AGENT_PW" \
    -v executor_password="$EXECUTOR_PW" \
    -v collector_password="$COLLECTOR_PW" \
    -f /tmp/db-roles.sql || echo "db-roles.sql failed this run -- will retry on the next 6h timer"
else
  echo "schema still missing after ~10 min -- db-roles.sql skipped, will retry on the next 6h timer"
fi
unset ADMIN_PW GATEWAY_PW AGENT_PW EXECUTOR_PW COLLECTOR_PW
rm -f /tmp/db-roles.sql
SCRIPT
chmod +x /usr/local/sbin/kaval-gitops-bootstrap
/usr/local/sbin/kaval-gitops-bootstrap

# Refreshed well inside the 12h ECR token lifetime, so a long-running node never drifts
# into a stale credential between reconciles.
cat > /etc/systemd/system/kaval-gitops-bootstrap.service <<'UNIT'
[Unit]
Description=Refresh Kaval's GitOps bootstrap (ECR credential + registry ConfigMap)
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kaval-gitops-bootstrap
UNIT

cat > /etc/systemd/system/kaval-gitops-bootstrap.timer <<'UNIT'
[Unit]
Description=Run the Kaval GitOps bootstrap refresh every 6 hours
[Timer]
OnBootSec=6h
OnUnitActiveSec=6h
[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now kaval-gitops-bootstrap.timer
