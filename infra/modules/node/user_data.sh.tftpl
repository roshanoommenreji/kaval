#!/bin/bash
# First-boot setup for the Kaval prod node. Runs once, as root, via cloud-init.
# Log: /var/log/cloud-init-output.log
set -euxo pipefail

# ── k3s, checksum-verified (not the official `curl | sh` installer — same reasoning as
#    the k3d/kubectl/helm downloads in infra/modules/devbox/user_data.sh.tftpl: trust a
#    pinned hash, not an unauthenticated script) ───────────────────────────────────────
K3S_VERSION="${k3s_version}"
K3S_SHA256="${k3s_sha256_arm64}"
curl -fsSLo /tmp/k3s "https://github.com/k3s-io/k3s/releases/download/$${K3S_VERSION/+/%2B}/k3s-arm64"
echo "$${K3S_SHA256}  /tmp/k3s" | sha256sum --check --strict
install -m 0755 /tmp/k3s /usr/local/bin/k3s
rm /tmp/k3s

modprobe br_netfilter || true
modprobe overlay || true

# Systemd unit hand-written from k3s's own install.sh template (SYSTEMD_TYPE=notify for a
# server), so the checksum-verified binary above gets the same supervision the official
# installer would have given it, without running that installer's own unverified script.
cat > /etc/systemd/system/k3s.service <<'UNIT'
[Unit]
Description=Kaval k3s server
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
KillMode=process
Delegate=yes
User=root
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s server --write-kubeconfig-mode=644 --disable=traefik

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now k3s

# ── kubectl + helm, same checksum-verified versions already pinned on the dev server ──
KUBECTL_VERSION=v1.37.1
KUBECTL_SHA256=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
curl -fsSLo /tmp/kubectl "https://dl.k8s.io/release/$${KUBECTL_VERSION}/bin/linux/arm64/kubectl"
echo "$${KUBECTL_SHA256}  /tmp/kubectl" | sha256sum --check --strict
install -m 0755 /tmp/kubectl /usr/local/bin/kubectl
rm /tmp/kubectl

HELM_VERSION=v4.3.0
HELM_SHA256=31c5794dd55c66a51e6b7d2e2ac7a114ae8b1de41ff1d9ba51748ac973b06a08
curl -fsSLo /tmp/helm.tgz "https://get.helm.sh/helm-$${HELM_VERSION}-linux-arm64.tar.gz"
echo "$${HELM_SHA256}  /tmp/helm.tgz" | sha256sum --check --strict
tar -xzf /tmp/helm.tgz -C /tmp linux-arm64/helm
install -m 0755 /tmp/linux-arm64/helm /usr/local/bin/helm
rm -rf /tmp/helm.tgz /tmp/linux-arm64

# kubectl/helm need a kubeconfig; k3s writes one root-only by default even with
# write-kubeconfig-mode=644 applied to its *contents* permissions, not its location.
install -d -m 755 /home/ec2-user/.kube
# Written after k3s has actually started and produced the file, not at the ExecStart
# line above -- ready-to-poll, not fixed-delay, since first boot is doing a lot else too.
for i in $(seq 1 60); do
  [ -s /etc/rancher/k3s/k3s.yaml ] && break
  sleep 2
done
cp /etc/rancher/k3s/k3s.yaml /home/ec2-user/.kube/config
chown -R ec2-user:ec2-user /home/ec2-user/.kube
chmod 600 /home/ec2-user/.kube/config

# A root shell reached via `sudo -i` or `aws ssm send-command` has no ~/.kube/config and
# (found live, KAV-50) no $HOME at all under plain SSM RunShellScript, so ~-expansion
# can't find one anyway. k3s's own file is already 644 (write-kubeconfig-mode above), so
# pointing KUBECONFIG at it directly sidesteps both problems without a second copy to
# keep in sync. /etc/environment covers login shells (SSH, `sudo -i`); a non-login
# `ssm send-command` still needs --kubeconfig spelled out explicitly, which is the
# ad-hoc-verification path, not the documented one (SSH through the SSM tunnel).
echo "KUBECONFIG=/etc/rancher/k3s/k3s.yaml" >> /etc/environment

# ── SSH, reachable only through the SSM tunnel (no inbound port is open) — same pattern
#    as infra/modules/devbox ──────────────────────────────────────────────────────────
install -d -m 700 -o ec2-user -g ec2-user /home/ec2-user/.ssh
echo "${ssh_public_key}" >> /home/ec2-user/.ssh/authorized_keys
chown ec2-user:ec2-user /home/ec2-user/.ssh/authorized_keys
chmod 600 /home/ec2-user/.ssh/authorized_keys

cat > /etc/ssh/sshd_config.d/10-kaval-keepalive.conf <<'CONF'
ClientAliveInterval 30
ClientAliveCountMax 3
CONF
systemctl reload sshd

# ── Flux, checksum-verified (KAV-51) — same reasoning as k3s/kubectl/helm above. `flux
# install` only (not `flux bootstrap`, which commits a flux-system manifest straight to
# `main` and would bypass the PR-required branch protection, CLAUDE.md) — it applies the
# controllers' own manifests, embedded in the binary, with no extra network fetch. ──────
FLUX_VERSION="${flux_version}"
FLUX_SHA256="${flux_sha256_arm64}"
curl -fsSLo /tmp/flux.tar.gz \
  "https://github.com/fluxcd/flux2/releases/download/v$${FLUX_VERSION}/flux_$${FLUX_VERSION}_linux_arm64.tar.gz"
echo "$${FLUX_SHA256}  /tmp/flux.tar.gz" | sha256sum --check --strict
tar -xzf /tmp/flux.tar.gz -C /tmp flux
install -m 0755 /tmp/flux /usr/local/bin/flux
rm -f /tmp/flux.tar.gz /tmp/flux

export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
flux install

# This node has no EKS-style credential provider for ECR (ADR-0024's IAM-scoping decision:
# per-workload AWS identity is Phase 7/8 IRSA territory, not this story). So two things get
# refreshed from the node's own instance role instead of committed to Git: the registry
# hostname itself (it embeds the AWS account ID — CLAUDE.md forbids that in any committed
# file) and an ECR login token (ecr:GetAuthorizationToken tokens expire every 12h). Both
# are consumed by deploy/gitops/prod/helmrelease.yaml's valuesFrom (the ConfigMap) and the
# chart's imagePullSecrets (the Secret) — see deploy/charts/kaval/values.yaml.
cat > /usr/local/sbin/kaval-gitops-bootstrap <<'SCRIPT'
#!/bin/bash
set -euxo pipefail
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

TOKEN=$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
REGION=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
ACCOUNT=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/dynamic/instance-identity/document \
  | sed -n 's/.*"accountId" *: *"\([0-9]\+\)".*/\1/p')
REGISTRY="$ACCOUNT.dkr.ecr.$REGION.amazonaws.com"

# The repo's own bootstrap manifests. Flux's own GitRepository (applied below, once) takes
# over all reconciliation of these same files from here on — this apply only has to run
# again if the node itself is replaced (spot reclamation), which is the self-healing
# property the Phase 4 exit gate tests.
RAW="https://raw.githubusercontent.com/roshanoommenreji/kaval/main/deploy/gitops/prod"
curl -fsSL "$RAW/namespace.yaml" | kubectl apply -f -

kubectl create configmap kaval-registry --from-literal=registry="$REGISTRY" \
  -n flux-system --dry-run=client -o yaml | kubectl apply -f -

ECR_PASSWORD=$(aws ecr get-login-password --region "$REGION")
kubectl create secret docker-registry ecr-cred \
  --docker-server="$REGISTRY" --docker-username=AWS --docker-password="$ECR_PASSWORD" \
  -n kaval-prod --dry-run=client -o yaml | kubectl apply -f -

curl -fsSL "$RAW/source.yaml" | kubectl apply -f -
curl -fsSL "$RAW/helmrelease.yaml" | kubectl apply -f -
SCRIPT
chmod +x /usr/local/sbin/kaval-gitops-bootstrap
/usr/local/sbin/kaval-gitops-bootstrap

# Refreshed well inside the 12h ECR token lifetime, so a long-running node never drifts
# into a stale credential between reconciles.
cat > /etc/systemd/system/kaval-gitops-bootstrap.service <<'UNIT'
[Unit]
Description=Refresh Kaval's GitOps bootstrap (ECR credential + registry ConfigMap)
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kaval-gitops-bootstrap
UNIT

cat > /etc/systemd/system/kaval-gitops-bootstrap.timer <<'UNIT'
[Unit]
Description=Run the Kaval GitOps bootstrap refresh every 6 hours
[Timer]
OnBootSec=6h
OnUnitActiveSec=6h
[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now kaval-gitops-bootstrap.timer
