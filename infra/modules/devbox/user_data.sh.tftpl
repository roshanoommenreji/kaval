#!/bin/bash
# First-boot setup for the Kaval dev server. Runs once, as root, via cloud-init.
# Log: /var/log/cloud-init-output.log
set -euxo pipefail

# ── tools ────────────────────────────────────────────────────────────────
dnf install -y docker git make python3.11 python3.11-pip jq
systemctl enable --now docker
usermod -aG docker ec2-user

# Amazon Linux's docker package ships without the compose and buildx plugins.
plugins=/usr/local/lib/docker/cli-plugins
mkdir -p "$plugins"
curl -fsSL -o "$plugins/docker-compose" \
  https://github.com/docker/compose/releases/latest/download/docker-compose-linux-aarch64
buildx_url=$(curl -fsSL https://api.github.com/repos/docker/buildx/releases/latest \
  | jq -r '.assets[] | select(.name | endswith("linux-arm64")) | .browser_download_url')
curl -fsSL -o "$plugins/docker-buildx" "$buildx_url"
chmod +x "$plugins/docker-compose" "$plugins/docker-buildx"

# ── k3d, kubectl, helm (Phase 3, Lab 15) — checksum-verified, same pattern as the opa/
# gitleaks/Trivy downloads elsewhere in this repo, unlike the docker-compose/buildx plugins
# above which trust "latest" with no checksum (an earlier gap, not repeated for new tools) ──
K3D_VERSION=v5.9.0
K3D_SHA256=03cde5cf23e6e8e67de5a039ecf26e5b85aca82fba3e5d13dadf904cd218a250
curl -fsSLo /tmp/k3d "https://github.com/k3d-io/k3d/releases/download/$${K3D_VERSION}/k3d-linux-arm64"
echo "$${K3D_SHA256}  /tmp/k3d" | sha256sum --check --strict
install -m 0755 /tmp/k3d /usr/local/bin/k3d
rm /tmp/k3d

KUBECTL_VERSION=v1.37.1
KUBECTL_SHA256=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7
curl -fsSLo /tmp/kubectl "https://dl.k8s.io/release/$${KUBECTL_VERSION}/bin/linux/arm64/kubectl"
echo "$${KUBECTL_SHA256}  /tmp/kubectl" | sha256sum --check --strict
install -m 0755 /tmp/kubectl /usr/local/bin/kubectl
rm /tmp/kubectl

HELM_VERSION=v4.3.0
HELM_SHA256=31c5794dd55c66a51e6b7d2e2ac7a114ae8b1de41ff1d9ba51748ac973b06a08
curl -fsSLo /tmp/helm.tgz "https://get.helm.sh/helm-$${HELM_VERSION}-linux-arm64.tar.gz"
echo "$${HELM_SHA256}  /tmp/helm.tgz" | sha256sum --check --strict
tar -xzf /tmp/helm.tgz -C /tmp linux-arm64/helm
install -m 0755 /tmp/linux-arm64/helm /usr/local/bin/helm
rm -rf /tmp/helm.tgz /tmp/linux-arm64

# ── SSH, reachable only through the SSM tunnel (no inbound port is open) ──
install -d -m 700 -o ec2-user -g ec2-user /home/ec2-user/.ssh
echo "${ssh_public_key}" >> /home/ec2-user/.ssh/authorized_keys
chown ec2-user:ec2-user /home/ec2-user/.ssh/authorized_keys
chmod 600 /home/ec2-user/.ssh/authorized_keys

# Drop connections whose client has gone. Through the SSM tunnel sshd's TCP peer is the
# local session worker, which stays up after the laptop's ssh exits, so without a probe
# every `docker --context` call leaves its connection (and SSM session) open for SSM's
# 20-minute idle timeout: ~7 per `compose up`, 42 open within 20 minutes, new handshakes
# timing out, and the idle-stop below counting the dead ones as "active" (found 2026-09-27,
# KAV-23). A live client answers the probe, so the tunnel and terminals are unaffected.
cat > /etc/ssh/sshd_config.d/10-kaval-keepalive.conf <<'CONF'
ClientAliveInterval 30
ClientAliveCountMax 3
CONF
systemctl reload sshd

# ── stop after ${idle_minutes} idle minutes ────────────────────────────────
# "Active" = any SSH connection (the laptop's docker commands and terminals all
# arrive this way) or an SSM shell session. Checked every 5 minutes.
install -d /var/lib/kaval
cat > /usr/local/sbin/kaval-idle-stop <<'SCRIPT'
#!/bin/bash
state=/var/lib/kaval/last-active
limit=$((IDLE_MINUTES * 60))
now=$(date +%s)
if ss -Htn state established '( sport = :22 )' | grep -q . \
   || pgrep -f ssm-session-worker >/dev/null; then
  echo "$now" > "$state"
  exit 0
fi
last=$(cat "$state" 2>/dev/null)
# Anything but a plain number (missing, empty, corrupted) restarts the clock. Without this, a
# bad value makes the arithmetic below fail on every run, and the server never stops.
[[ "$last" =~ ^[0-9]+$ ]] || { echo "$now" > "$state"; exit 0; }
idle=$(( now - last ))
if [ "$idle" -ge "$limit" ]; then
  logger -t kaval-idle "idle for $idle s, stopping the instance"
  shutdown -h now
fi
SCRIPT
sed -i "s/IDLE_MINUTES/${idle_minutes}/" /usr/local/sbin/kaval-idle-stop
chmod +x /usr/local/sbin/kaval-idle-stop

# On every boot, start the idle clock fresh; otherwise the timestamp left over
# from before the last stop would shut the server down the moment it starts.
# `%%s`, not `%s`: systemd expands `%s` in unit files to the user's shell, which
# turned `date +%s` into `date +/bin/bash` (found on the first real boot).
cat > /etc/systemd/system/kaval-idle-reset.service <<'UNIT'
[Unit]
Description=Reset the Kaval idle clock at boot
[Service]
Type=oneshot
ExecStart=/bin/sh -c 'date +%%s > /var/lib/kaval/last-active'
[Install]
WantedBy=multi-user.target
UNIT

cat > /etc/systemd/system/kaval-idle-stop.service <<'UNIT'
[Unit]
Description=Stop the Kaval dev server when nobody is using it
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kaval-idle-stop
UNIT

cat > /etc/systemd/system/kaval-idle-stop.timer <<'UNIT'
[Unit]
Description=Check for idleness every 5 minutes
[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable kaval-idle-reset.service
systemctl start kaval-idle-reset.service
systemctl enable --now kaval-idle-stop.timer
