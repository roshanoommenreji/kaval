# The one place the three third-party images are named for the bot (KAV-170, ADR-0108).
#
# NEVER BUILT. Nothing runs this file. Dependabot's "docker" updater reads FROM lines (tag and digest) and
# opens a pull request when a newer release, or a rebuilt tag with a new digest, appears. The same image is
# named in six other files; `python scripts/dev/sync_third_party_images.py` copies the pin from here into
# every one of them, and scripts/dev/test_third_party_image_pins.py fails when they disagree. So a bot pull
# request goes red until that script has been run and its result committed to the bot's branch. The steps:
# docs/runbooks/third-party-image-bump.md.
#
# Stay on PostgreSQL 16 and on Debian bookworm for the database (a newer Debian changes the text sort order
# and can corrupt indexes, KAV-169): the tag's "-pg16-bookworm" suffix keeps Dependabot on that line, and the
# sync script refuses anything else.
#
# One image per line, one stage name per image: the name is how the sync script finds the line.

FROM pgvector/pgvector:0.8.7-pg16-bookworm@sha256:484e838076e04939d27d3e176e91c86eea96236126023be8d3059761122e579f AS database
FROM ollama/ollama:0.40.16@sha256:910d0d8107b538fb0894e63163eb195de0cc7aefcbc666dc62d3b18f71124592 AS ollama
FROM quay.io/prometheus/prometheus:v3.16.0@sha256:9332054523223e2ddc18d8101799d54a4a8d823b030c53216f063a6c117773cd AS prometheus
