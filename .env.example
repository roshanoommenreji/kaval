# Copy to .env and fill in. NEVER commit .env — the repo goes public at v1.
# Placeholders only in this file. No real account IDs, ARNs, or endpoints.

# ─── AWS ───────────────────────────────────────────────────
# Use a named profile rather than keys in this file wherever possible.
AWS_PROFILE=kaval
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=000000000000

# ─── cost guardrails ───────────────────────────────────────
BUDGET_MONTHLY_USD=40
BUDGET_ALERT_1_USD=18
BUDGET_ALERT_2_USD=22
BUDGET_HARD_STOP_USD=24
BUDGET_ALERT_EMAIL=you@example.com

# ─── database ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kaval
POSTGRES_USER=kaval
POSTGRES_PASSWORD=change-me-locally-only

# ─── inference ─────────────────────────────────────────────
# Local Ollama serving Gemma. OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=gemma3:1b

# Bedrock escalation for novel / low-confidence incidents.
# Verify the current model ID and pricing with the `claude-api` skill.
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=
ESCALATION_CONFIDENCE_THRESHOLD=0.7

# Jev (TypeSafe) risk rating — see ADR-0006. Key from TypeSafe's own console only.
# Pin a version; `jev-latest` moves and can change answers. Disabled → rules-only, everything `ask`.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_ENABLED=false

# ─── agent behaviour ───────────────────────────────────────
# ask | auto — start at `ask` for everything. Autonomy is earned, not assumed.
DEFAULT_AUTONOMY=ask
PROPOSAL_POLL_INTERVAL_SEC=30
OUTCOME_MEASURE_DELAY_SEC=300

# ─── mobile / auth ─────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
EXPO_PUSH_TOKEN=

# ─── observability ─────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
LOG_LEVEL=INFO

# ─── project tracking (scripts/tracking/ only — no Kaval service reads these) ─
# One Atlassian API token covers both Jira and Confluence on the same site.
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
