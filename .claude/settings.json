      "Bash(terraform destroy:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(aws lambda invoke:*)",
      "Bash(make up:*)",
      "Bash(make down:*)",
      "Bash(make nuke:*)",
      "Bash(make lab-up:*)",
      "Bash(git push:*)"
